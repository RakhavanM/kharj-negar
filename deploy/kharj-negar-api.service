[Unit]
Description=Kharj Negar API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=kharjapp
Group=kharjapp
WorkingDirectory=/opt/kharj-negar/backend
EnvironmentFile=/etc/kharj-negar/backend.env
Environment=KHARJ_ENV_FILE=/etc/kharj-negar/backend.env
Environment=PYTHONPATH=/opt/kharj-negar/backend/vendor
ExecStart=/opt/kharj-negar/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/kharj-negar

[Install]
WantedBy=multi-user.target
